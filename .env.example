# --- Frontend (Vite) ---
# IMPORTANTE: el prefijo debe ser exactamente "VITE_" (no "ITE_" ni sin prefijo).
# Se incrustan en el build; si los cambiás, hay que volver a desplegar.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Cloudflare Pages Function (secreto de servidor) ---
# NO lleva prefijo VITE_. Se configura como Secret en Cloudflare, no en este archivo
# para producción. Incluido aquí solo como referencia del nombre esperado.
# GEMINI_API_KEY=
